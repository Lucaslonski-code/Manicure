{
  "expo": {
    "name": "AppManicure",
    "slug": "appmanicure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.appmanicure.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "backgroundColor": "#F5F0EA"
      },
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/icons/favicon.png"
    },
    "scheme": "appmanicure",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/android-icon-monochrome.png",
          "color": "#331E0B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F0EA"
        }
      ],
      "./plugins/withCleanupPermissions"
    ],
    "extra": {
      "eas": {
        "projectId": "a226cf72-77b8-49c0-b51e-2721c2676b8a"
      }
    },
    "owner": "lucaslonski",
    "primaryColor": "#25221F"
  }
}
