              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "appointments"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "client_id", "value": "eq.{{client_a_email}}" }
              ]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
