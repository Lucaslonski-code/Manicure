    {
      "name": "08 — Data Setup",
      "item": [
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manicure\",\n  \"duration_minutes\": 60,\n  \"price\": 50.00\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/services",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "services"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('service_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cleanup Created Test Data",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/appointments?id=in.({{appointment_id}})",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "appointments"],
              "query": [{ "key": "id", "value": "in.({{appointment_id}})" }]
            }
          }
        }
      ]
    }
  ]
}
