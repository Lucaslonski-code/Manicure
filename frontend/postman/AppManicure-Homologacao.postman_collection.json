    {
      "name": "07 — Security Tests",
      "item": [
        {
          "name": "Client A acessa dados de Client B",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/appointments?select=*&client_id=eq.{{client_b_email}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "appointments"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "client_id", "value": "eq.{{client_b_email}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Deve retornar 401/403 ou vazio (não deve expor dados de outro cliente)', function () {",
                  "    pm.expect([200, 401, 403]).toInclude(pm.response.code);",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(pm.response.json().length).toBe(0);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin A modifica Professional B",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hackeado\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/professionals?id=eq.{{professional_b_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "professionals"],
              "query": [{ "key": "id", "value": "eq.{{professional_b_id}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin NÃO deve modificar profissional de outro admin (esperado 403)', function () {",
                  "    pm.expect(pm.response.code).toBe(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Role Tampering — Client tenta criar profissional",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"hacker@example.com\",\n  \"phone\": \"11999999999\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/professionals",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "professionals"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Client não deve criar profissional (esperado 401/403)', function () {",
                  "    pm.expect([401, 403]).toInclude(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Direct Appointment Insert — Client insere para outro profissional",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_id\": \"{{professional_b_id}}\",\n  \"service_id\": \"{{service_id}}\",\n  \"scheduled_at\": \"{{$timestamp}}\",\n  \"status\": \"scheduled\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/appointments",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "appointments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Client não deve inserir agendamento para outro profissional (esperado 401/403)', function () {",
                  "    pm.expect([401, 403]).toInclude(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Professional ID Tampering",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{professional_b_id}}\",\n  \"name\": \"Hackeado\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/professionals?id=eq.{{professional_a_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "professionals"],
              "query": [{ "key": "id", "value": "eq.{{professional_a_id}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Não deve permitir alterar ID de profissional (esperado 401/403)', function () {",
                  "    pm.expect([401, 403]).toInclude(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Notification Abuse — sem token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"<DEVICE_PUSH_TOKEN>\",\n  \"title\": \"Abuse\",\n  \"body\": \"Teste\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/functions/v1/send-push-notification",
              "host": ["{{supabase_url}}"],
              "path": ["functions", "v1", "send-push-notification"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Edge Function deve rejeitar requisição sem autenticação (esperado 401)', function () {",
                  "    pm.expect(pm.response.code).toBe(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Third-party Account Deletion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{supabase_url}}/functions/v1/delete-account-external",
              "host": ["{{supabase_url}}"],
              "path": ["functions", "v1", "delete-account-external"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Third-party account deletion deve ser rejeitada (esperado 403)', function () {",
                  "    pm.expect(pm.response.code).toBe(403);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
